{
    "name": "reformtech/short-url",
    "description": "A framework-agnostic URL shortener core with an optional Laravel integration layer.",
    "type": "library",
    "license": "MIT",
    "keywords": ["php", "laravel", "url", "shortener", "short-url", "redirect"],
    "authors": [
        {
            "name": "ReformTech Solutions",
            "email": "info@reformtech.in"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0 || ^9.0",
        "illuminate/support": "^10.0 || ^11.0",
        "illuminate/database": "^10.0 || ^11.0",
        "illuminate/routing": "^10.0 || ^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "config": {
        "sort-packages": true
    },
    "suggest": {
        "illuminate/support": "Required if you want to use the Laravel integration layer (facade, service provider).",
        "illuminate/database": "Required if you want to use the built-in Eloquent storage adapter."
    },
    "autoload": {
        "psr-4": {
            "Reformtech\\ShortUrl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Reformtech\\ShortUrl\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Reformtech\\ShortUrl\\Laravel\\UrlShortenerServiceProvider"
            ],
            "aliases": {
                "ShortUrl": "Reformtech\\ShortUrl\\Laravel\\Facades\\ShortUrl"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
